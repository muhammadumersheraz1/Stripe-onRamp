# Stripe API keys (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret (Dashboard → Developers → Webhooks)
# Listen for: crypto.onramp_session.updated
STRIPE_WEBHOOK_SECRET=whsec_...

# Server
PORT=4242

# Merchant settlement — locked into every onramp session
# Customer never chooses these; they only pay with card.
ONRAMP_WALLET_ADDRESS=0xYourSettlementWallet
ONRAMP_DESTINATION_CURRENCY=usdc
ONRAMP_DESTINATION_NETWORK=ethereum
